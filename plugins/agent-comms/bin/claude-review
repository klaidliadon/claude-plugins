#!/usr/bin/env bash
# claude-review — spawn a non-interactive Claude reviewer with the prompt fed on
# stdin. Keep this as the Codex-side mirror of codex-review: prompt-file only,
# print mode, and permission prompts disabled so a background reviewer cannot
# stall waiting for TTY interaction.
#
# Usage: claude-review --prompt-file <path> [comms handshake flags] [extra claude -p args...]
set -euo pipefail

prompt_file=""
channel=""
me=""
root=""
dir=""
rest=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --prompt-file=*) prompt_file="${1#*=}" ;;
    --prompt-file|-f) shift; prompt_file="${1:-}" ;;
    --channel) shift; channel="${1:-}" ;;
    --me) shift; me="${1:-}" ;;
    --root) shift; root="${1:-}" ;;
    --dir) shift; dir="${1:-}" ;;
    *) rest+=("$1") ;;
  esac
  shift
done

if [ -z "$prompt_file" ]; then
  echo "usage: claude-review --prompt-file <path> [--channel C --me M (--root R|--dir D)] [extra claude -p args...]" >&2
  exit 2
fi
if [ ! -f "$prompt_file" ]; then
  echo "claude-review: prompt file not found: $prompt_file" >&2
  exit 2
fi
if [ -n "$channel$me$root$dir" ] && { [ -z "$channel" ] || [ -z "$me" ]; }; then
  echo "claude-review: --channel and --me are both required for comms bootstrap" >&2
  exit 2
fi
if [ -n "$channel" ] && { ! [[ "$channel" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*(\.[A-Za-z0-9][A-Za-z0-9_-]*)*$ ]] || ! [[ "$me" =~ ^[A-Za-z0-9][A-Za-z0-9_-]*(\.[A-Za-z0-9][A-Za-z0-9_-]*)*$ ]]; }; then
  echo "claude-review: invalid channel or reviewer name" >&2
  exit 2
fi

input_file="$prompt_file"
if [ -n "$channel" ]; then
  ack_args=(agent-comms ack --channel "$channel" --from "$me")
  recv_args=(agent-comms recv --channel "$channel" --me "$me")
  [ -n "$root" ] && { ack_args+=(--root "$root"); recv_args+=(--root "$root"); }
  [ -n "$dir" ] && { ack_args+=(--dir "$dir"); recv_args+=(--dir "$dir"); }
  printf -v ack_command '%q ' "${ack_args[@]}"
  printf -v recv_command '%q ' "${recv_args[@]}"
  ack_command="${ack_command% }"
  recv_command="${recv_command% }"
  input_file="$(mktemp "${TMPDIR:-/tmp}/claude-review.XXXXXX")"
  trap 'rm -f "$input_file"' EXIT
  {
    cat "$prompt_file"
    printf '\n\n## Mandatory startup handshake\n\n'
    printf 'Before inspecting the repository or starting the first task, run exactly:\n\n    %s\n\n' "$ack_command"
    printf 'Only after the ACK succeeds, wait for the first task by running exactly:\n\n    %s\n' "$recv_command"
  } > "$input_file"
fi

if [ "${#rest[@]}" -gt 0 ]; then
  claude -p --permission-mode bypassPermissions --add-dir "$PWD" "${rest[@]}" < "$input_file"
  exit $?
fi
claude -p --permission-mode bypassPermissions --add-dir "$PWD" < "$input_file"
