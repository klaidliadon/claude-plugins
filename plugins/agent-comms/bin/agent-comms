#!/usr/bin/env bash
# agent-comms — single entrypoint for the 2-party agent review-loop transport.
# Subcommands: init | send | recv | wait-ready | resume | launch | transcript | path | hash | install | update | doctor | release
set -euo pipefail
SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
AGENT_COMMS_RUNTIME_ROOT="$(cd "$HERE/.." && pwd)"
export AGENT_COMMS_RUNTIME_ROOT
source "$HERE/lib.sh"

usage() {
  cat >&2 <<'EOF'
agent-comms — 2-party agent review-loop transport
usage:
  agent-comms init       --channel C --session S --driver D --peer P --release V --digest H --protocol 2 --release-root R [--semantic-timeout 1..3600]
  agent-comms send       --channel C --from F --generation N [--continue] [--tag TAG] [--body-file F] [--review-ref|--approve-ref|--converged-ref FILE]
                                                             (body on stdin unless --body-file; a --*-ref hashes FILE and sets the wire tag)
  agent-comms recv       --channel C --me M [--timeout N]    (blocks; prints peer msg or __TIMEOUT__)
  agent-comms wait-ready --channel C --me M --peer P --generation N [--timeout N]
  agent-comms resume     --channel C --from F --generation N --replace ROLE --body-file F [--artifact-file F]
                                                             (replace the interrupted peer and emit its bounded resume packet)
  agent-comms launch     <claude|codex> --role <driver|reviewer> --peer NAME --channel C
                         --generation N --prompt-file F --client-release V [runtime args after --]
  agent-comms transcript --channel C                         (clean chat view)
  agent-comms path       --channel C                         (resolved channel file path)
  agent-comms hash       <file>                              (sha256 of file, for review/approve refs)
  agent-comms install                                        (verify and atomically activate Claude's selected release)
  agent-comms update [--check]                               (check or reconcile an updated release)
  agent-comms doctor [--quiet]                               (verify one immutable release)
  agent-comms release <manifest|check|publish>                (maintainer release workflow)

global options (any subcommand; precedence --dir > --root > $AGENT_COMMS_ROOT > git root > $PWD):
  --root DIR   repo root; channel lives at DIR/tmp/agent-comms
  --dir  DIR   exact comms dir (overrides --root); DIR's parent must exist
EOF
}

cmd_init() {
  local CHANNEL="" SESSION="" DRIVER="" PEER="" RELEASE="" DIGEST="" PROTOCOL="" RELEASE_ROOT=""
  local PROGRESS_FRAMES=8 PROGRESS_BYTES=512 HEARTBEAT_AFTER=30 HEARTBEAT_INTERVAL=30
  local SEMANTIC_TIMEOUT=300
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel) CHANNEL="$2"; shift 2;;
      --session) SESSION="$2"; shift 2;;
      --driver) DRIVER="$2"; shift 2;;
      --peer) PEER="$2"; shift 2;;
      --release) RELEASE="$2"; shift 2;;
      --digest) DIGEST="$2"; shift 2;;
      --protocol) PROTOCOL="$2"; shift 2;;
      --release-root) RELEASE_ROOT="$2"; shift 2;;
      --progress-frames) PROGRESS_FRAMES="$2"; shift 2;;
      --progress-bytes) PROGRESS_BYTES="$2"; shift 2;;
      --heartbeat-after) HEARTBEAT_AFTER="$2"; shift 2;;
      --heartbeat-interval) HEARTBEAT_INTERVAL="$2"; shift 2;;
      --semantic-timeout) SEMANTIC_TIMEOUT="$2"; shift 2;;
      *) echo "unknown arg: $1" >&2; exit 64;;
    esac
  done
  if ! valid_name "$CHANNEL"; then echo "bad --channel" >&2; exit 64; fi
  if ! valid_name "$SESSION"; then echo "bad --session" >&2; exit 64; fi
  if ! valid_name "$DRIVER"; then echo "bad --driver" >&2; exit 64; fi
  if ! valid_name "$PEER"; then echo "bad --peer" >&2; exit 64; fi
  if [ -z "$RELEASE" ] || [ -z "$DIGEST" ] || [ -z "$PROTOCOL" ] || [ -z "$RELEASE_ROOT" ]; then
    if [ -n "$RELEASE$DIGEST$PROTOCOL$RELEASE_ROOT" ]; then
      echo "release identity must be fully explicit or fully automatic" >&2
      exit 64
    fi
    RELEASE_ROOT="$(realpath "$AGENT_COMMS_RUNTIME_ROOT")"
    if [ ! -f "$RELEASE_ROOT/manifest.lock" ]; then
      echo "cannot initialize from an unmanifested release: $RELEASE_ROOT" >&2
      exit 1
    fi
    bash "$HERE/release.sh" verify --root "$RELEASE_ROOT"
    RELEASE="$(plugin_version "$RELEASE_ROOT")"
    DIGEST="$(file_sha256 "$RELEASE_ROOT/manifest.lock")"
    PROTOCOL=2
  else
    if [ ! -f "$RELEASE_ROOT/manifest.lock" ]; then
      echo "explicit release root is missing or unmanifested: $RELEASE_ROOT" >&2
      exit 1
    fi
    RELEASE_ROOT="$(realpath "$RELEASE_ROOT")"
    bash "$HERE/release.sh" verify --root "$RELEASE_ROOT"
    if [ "$RELEASE" != "$(plugin_version "$RELEASE_ROOT")" ] ||
       [ "$DIGEST" != "$(file_sha256 "$RELEASE_ROOT/manifest.lock")" ] ||
       [ "$PROTOCOL" != "2" ]; then
      echo "explicit release identity does not match $RELEASE_ROOT" >&2
      exit 1
    fi
  fi
  local dir file
  dir="$(comms_dir)"; mkdir -p "$dir/.cursors/$CHANNEL"
  file="$(channel_file "$CHANNEL")"; assert_confined "$file"
  perl "$HERE/protocol.pl" init \
    --file "$file" \
    --session "$SESSION" \
    --driver "$DRIVER" \
    --peer "$PEER" \
    --release "$RELEASE" \
    --digest "$DIGEST" \
    --protocol "$PROTOCOL" \
    --release-root "$RELEASE_ROOT" \
    --progress-frames "$PROGRESS_FRAMES" \
    --progress-bytes "$PROGRESS_BYTES" \
    --heartbeat-after "$HEARTBEAT_AFTER" \
    --heartbeat-interval "$HEARTBEAT_INTERVAL" \
    --semantic-timeout "$SEMANTIC_TIMEOUT"
}

cmd_send() {
  local CHANNEL="" FROM="" TAG="" BODYFILE="" REFKIND="" REFFILE="" GENERATION="" STATE="over"
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel)        CHANNEL="$2";  shift 2;;
      --from)           FROM="$2";     shift 2;;
      --tag)            TAG="$2";      shift 2;;
      --body-file)      BODYFILE="$2"; shift 2;;
      --generation)     GENERATION="$2"; shift 2;;
      --continue)       STATE="continue"; shift;;
      --review-ref)     REFKIND="review-ref";     REFFILE="$2"; shift 2;;
      --approve-ref)    REFKIND="approve-ref";    REFFILE="$2"; shift 2;;
      --converged-ref)  REFKIND="converged-ref";  REFFILE="$2"; shift 2;;
      *) echo "unknown arg: $1" >&2; exit 64;;
    esac
  done
  if ! valid_name "$CHANNEL"; then echo "bad --channel" >&2; exit 64; fi
  if ! valid_name "$FROM";    then echo "bad --from"    >&2; exit 64; fi
  # A --*-ref flag hashes the artifact in-process and becomes the wire tag, so the
  # caller never threads a literal hash (no $() capture, no stale-hash bug).
  if [ -n "$REFFILE" ]; then
    if [ -n "$TAG" ]; then echo "--tag and --${REFKIND%-ref}-ref are mutually exclusive" >&2; exit 64; fi
    if [ ! -f "$REFFILE" ]; then echo "no such ref file: $REFFILE" >&2; exit 64; fi
    local h; h="$(file_sha256 "$REFFILE")"
    TAG="$REFKIND=$h"
    echo "$TAG" >&2   # audit: surface the computed ref without polluting stdout
  fi
  if [ -n "$TAG" ] && ! valid_tag "$TAG"; then echo "bad --tag" >&2; exit 64; fi
  if [ -n "$BODYFILE" ] && [ ! -f "$BODYFILE" ]; then echo "no such --body-file: $BODYFILE" >&2; exit 64; fi
  case "$GENERATION" in ''|*[!0-9]*) echo "bad --generation" >&2; exit 64;; esac
  local v2dir v2file temp_body="" KIND="message"
  v2dir="$(comms_dir)"; mkdir -p "$v2dir/.cursors/$CHANNEL"
  v2file="$(channel_file "$CHANNEL")"; assert_confined "$v2file"
  if [ -z "$BODYFILE" ]; then
    temp_body="$(mktemp "${TMPDIR:-/tmp}/agent-comms-body.XXXXXX")"
    trap 'rm -f "${temp_body:-}"' EXIT
    cat > "$temp_body"
    BODYFILE="$temp_body"
  fi
  [ -n "$TAG" ] || TAG="-"
  case "$TAG" in
    converged-ref=*|stopped-reason=*)
      if [ "$STATE" = "continue" ]; then echo "terminal send cannot use --continue" >&2; exit 64; fi
      KIND="control"
      STATE="terminal"
      ;;
  esac
  perl "$HERE/protocol.pl" append \
    --file "$v2file" \
    --sender "$FROM" \
    --generation "$GENERATION" \
    --kind "$KIND" \
    --state "$STATE" \
    --tag="$TAG" \
    --body-file "$BODYFILE"
}

cmd_recv() {
  local CHANNEL="" ME="" TIMEOUT=590 GENERATION="" SILENCE_SECONDS="" TURN_SECONDS=1800
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel) CHANNEL="$2"; shift 2;;
      --me)      ME="$2";      shift 2;;
      --timeout) TIMEOUT="$2"; shift 2;;
      --generation) GENERATION="$2"; shift 2;;
      --silence-seconds) SILENCE_SECONDS="$2"; shift 2;;
      --turn-seconds) TURN_SECONDS="$2"; shift 2;;
      *) echo "unknown arg: $1" >&2; exit 64;;
    esac
  done
  if ! valid_name "$CHANNEL"; then echo "bad --channel" >&2; exit 64; fi
  if ! valid_name "$ME";      then echo "bad --me"      >&2; exit 64; fi
  case "$GENERATION" in ''|*[!0-9]*) echo "bad --generation" >&2; exit 64;; esac
  [ -n "$SILENCE_SECONDS" ] || SILENCE_SECONDS="$TIMEOUT"
  local v2dir v2file v2cur
  v2dir="$(comms_dir)"; mkdir -p "$v2dir/.cursors/$CHANNEL"
  v2file="$(channel_file "$CHANNEL")"; assert_confined "$v2file"
  v2cur="$(cursor_file "$CHANNEL" "$ME.$GENERATION")"; assert_confined "$v2cur"
  perl "$HERE/protocol.pl" recv \
    --file "$v2file" \
    --cursor "$v2cur" \
    --me "$ME" \
    --generation "$GENERATION" \
    --silence-seconds "$SILENCE_SECONDS" \
    --turn-seconds "$TURN_SECONDS"
}

cmd_resume() {
  local CHANNEL="" FROM="" GENERATION="" REPLACE="" BODYFILE="" ARTIFACTFILE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel) CHANNEL="$2"; shift 2;;
      --from) FROM="$2"; shift 2;;
      --generation) GENERATION="$2"; shift 2;;
      --replace) REPLACE="$2"; shift 2;;
      --body-file) BODYFILE="$2"; shift 2;;
      --artifact-file) ARTIFACTFILE="$2"; shift 2;;
      *) echo "unknown arg: $1" >&2; exit 64;;
    esac
  done
  if ! valid_name "$CHANNEL"; then echo "bad --channel" >&2; exit 64; fi
  if ! valid_name "$FROM"; then echo "bad --from" >&2; exit 64; fi
  if ! valid_name "$REPLACE"; then echo "bad --replace" >&2; exit 64; fi
  case "$GENERATION" in ''|*[!0-9]*) echo "bad --generation" >&2; exit 64;; esac
  if [ -z "$BODYFILE" ] || [ ! -f "$BODYFILE" ]; then echo "no such --body-file: $BODYFILE" >&2; exit 64; fi
  if [ -n "$ARTIFACTFILE" ] && [ ! -f "$ARTIFACTFILE" ]; then echo "no such --artifact-file: $ARTIFACTFILE" >&2; exit 64; fi
  local dir file result new_generation offset cursor temporary
  local protocol_args=()
  dir="$(comms_dir)"; mkdir -p "$dir/.cursors/$CHANNEL"
  file="$(channel_file "$CHANNEL")"; assert_confined "$file"
  protocol_args=(
    resume
    --file "$file" \
    --driver "$FROM" \
    --generation "$GENERATION" \
    --replace "$REPLACE" \
    --body-file "$BODYFILE"
  )
  if [ -n "$ARTIFACTFILE" ]; then
    protocol_args+=(--artifact-file "$ARTIFACTFILE")
  fi
  result="$(perl "$HERE/protocol.pl" "${protocol_args[@]}")"
  case "$result" in
    generation=[0-9]*" cursor="[0-9]*) ;;
    *) echo "invalid resume result: $result" >&2; exit 1;;
  esac
  new_generation="${result#generation=}"
  new_generation="${new_generation%% *}"
  offset="${result##* cursor=}"
  cursor="$(cursor_file "$CHANNEL" "$REPLACE.$new_generation")"; assert_confined "$cursor"
  temporary="$cursor.$$"
  printf '%s\n' "$offset" > "$temporary"
  mv "$temporary" "$cursor"
}

cmd_wait_ready() {
  local CHANNEL="" ME="" PEER="" GENERATION="" TIMEOUT=30
  while [ $# -gt 0 ]; do
    case "$1" in
      --channel) CHANNEL="$2"; shift 2;;
      --me) ME="$2"; shift 2;;
      --peer) PEER="$2"; shift 2;;
      --generation) GENERATION="$2"; shift 2;;
      --timeout) TIMEOUT="$2"; shift 2;;
      *) echo "unknown arg: $1" >&2; exit 64;;
    esac
  done
  if ! valid_name "$CHANNEL"; then echo "bad --channel" >&2; exit 64; fi
  if ! valid_name "$ME"; then echo "bad --me" >&2; exit 64; fi
  if ! valid_name "$PEER"; then echo "bad --peer" >&2; exit 64; fi
  case "$GENERATION" in ''|*[!0-9]*) echo "bad --generation" >&2; exit 64;; esac
  local dir file cursor
  dir="$(comms_dir)"; mkdir -p "$dir/.cursors/$CHANNEL"
  file="$(channel_file "$CHANNEL")"; assert_confined "$file"
  cursor="$(cursor_file "$CHANNEL" "control.$ME")"; assert_confined "$cursor"
  perl "$HERE/protocol.pl" wait-control \
    --file "$file" \
    --cursor "$cursor" \
    --me "$ME" \
    --tag "launcher-ready=$PEER.$GENERATION" \
    --timeout "$TIMEOUT"
}

cmd_transcript() {
  local CHANNEL=""
  while [ $# -gt 0 ]; do case "$1" in --channel) CHANNEL="$2"; shift 2;; *) shift;; esac; done
  if ! valid_name "$CHANNEL"; then echo "bad --channel" >&2; exit 64; fi
  local file
  file="$(channel_file "$CHANNEL")"; [ -e "$file" ] || exit 0
  perl "$HERE/protocol.pl" transcript --file "$file"
}

cmd_launch() {
  COMMS_ROOT_FLAG="$COMMS_ROOT_FLAG" COMMS_DIR_FLAG="$COMMS_DIR_FLAG" \
    exec bash "$HERE/launch.sh" "$@"
}

cmd_path() {
  local CHANNEL=""
  while [ $# -gt 0 ]; do case "$1" in --channel) CHANNEL="$2"; shift 2;; *) shift;; esac; done
  if ! valid_name "$CHANNEL"; then echo "bad --channel" >&2; exit 64; fi
  channel_file "$CHANNEL"
}

cmd_hash() {
  local f="${1:-}"
  if [ -z "$f" ] || [ ! -f "$f" ]; then echo "usage: agent-comms hash <file>" >&2; exit 64; fi
  file_sha256 "$f"
}

cmd_doctor() {
  COMMS_ROOT_FLAG="$COMMS_ROOT_FLAG" COMMS_DIR_FLAG="$COMMS_DIR_FLAG" \
    bash "$HERE/release.sh" doctor "$@"
}

cmd_install() {
  bash "$HERE/release.sh" install "$@"
}

cmd_update() {
  bash "$HERE/release.sh" update "$@"
}

cmd_release() {
  bash "$HERE/release.sh" "$@"
}

cmd="${1:-}"; if [ $# -gt 0 ]; then shift; fi

# Global flags: pull --root/--dir from anywhere in the subcommand args so each
# command line starts with `agent-comms` (no env prefix → one allowlist rule).
# Shell vars (not exported) are inherited by the comms_* command substitutions.
COMMS_ROOT_FLAG="${COMMS_ROOT_FLAG:-}"
COMMS_DIR_FLAG="${COMMS_DIR_FLAG:-}"
rest=()
while [ $# -gt 0 ]; do
  case "$1" in
    --root) COMMS_ROOT_FLAG="$2"; shift 2;;
    --dir)  COMMS_DIR_FLAG="$(canon_dir "$2")"; shift 2;;
    *) rest=( ${rest[@]+"${rest[@]}"} "$1" ); shift;;
  esac
done
set -- ${rest[@]+"${rest[@]}"}

case "$cmd" in
  send|recv|wait-ready|resume|launch|transcript)
    CHANNEL_ARG=""
    scan=( ${rest[@]+"${rest[@]}"} )
    index=0
    while [ "$index" -lt "${#scan[@]}" ]; do
      if [ "${scan[$index]}" = "--channel" ]; then
        next=$((index + 1))
        CHANNEL_ARG="${scan[$next]:-}"
        break
      fi
      index=$((index + 1))
    done
    if valid_name "$CHANNEL_ARG"; then
      PIN_FILE="$(channel_file "$CHANNEL_ARG")"
      if [ -f "$PIN_FILE" ] && head -1 "$PIN_FILE" | grep -q '<!-- agent-comms v=2 '; then
        PIN_METADATA="$(mktemp "${TMPDIR:-/tmp}/agent-comms-pin.XXXXXX")"
        trap 'rm -f "${PIN_METADATA:-}"' EXIT
        perl "$HERE/protocol.pl" inspect --allow-incomplete --file "$PIN_FILE" > "$PIN_METADATA"
        PIN_ROOT="$(awk 'index($0, "release_root=") == 1 { print substr($0, 14); exit }' "$PIN_METADATA")"
        PIN_RELEASE="$(awk 'index($0, "release=") == 1 { print substr($0, 9); exit }' "$PIN_METADATA")"
        PIN_DIGEST="$(awk 'index($0, "digest=") == 1 { print substr($0, 8); exit }' "$PIN_METADATA")"
        if [ ! -d "$PIN_ROOT" ]; then
          echo "pinned release is missing: $PIN_ROOT; refusing to fall forward to current" >&2
          exit 1
        fi
        PIN_ROOT="$(realpath "$PIN_ROOT")"
        if [ "$(realpath "$AGENT_COMMS_RUNTIME_ROOT")" != "$PIN_ROOT" ]; then
          PIN_CACHE_BASE="$(dirname "$(realpath "$AGENT_COMMS_RUNTIME_ROOT")")"
          if [ -z "$PIN_CACHE_BASE" ] || [ "$PIN_ROOT" != "$PIN_CACHE_BASE/$PIN_RELEASE" ]; then
            echo "pinned release is outside the trusted cache: $PIN_ROOT" >&2
            exit 1
          fi
        fi
        bash "$HERE/release.sh" verify --root "$PIN_ROOT"
        if [ "$(plugin_version "$PIN_ROOT")" != "$PIN_RELEASE" ] ||
           [ "$(file_sha256 "$PIN_ROOT/manifest.lock")" != "$PIN_DIGEST" ]; then
          echo "pinned release identity mismatch: $PIN_ROOT" >&2
          exit 1
        fi
        rm -f "$PIN_METADATA"
        PIN_METADATA=""
        if [ "$(realpath "$AGENT_COMMS_RUNTIME_ROOT")" != "$PIN_ROOT" ]; then
          if [ "${AGENT_COMMS_DISPATCH_TRACE:-}" = "1" ]; then
            echo "dispatching pinned release: $PIN_ROOT" >&2
          fi
          forward=("$cmd" ${rest[@]+"${rest[@]}"})
          if [ -n "$COMMS_DIR_FLAG" ]; then
            forward+=(--dir "$COMMS_DIR_FLAG")
          elif [ -n "$COMMS_ROOT_FLAG" ]; then
            forward+=(--root "$COMMS_ROOT_FLAG")
          fi
          exec "$PIN_ROOT/bin/agent-comms" "${forward[@]}"
        fi
      fi
    fi
    ;;
esac

case "$cmd" in
  init|send|recv|wait-ready|resume|launch|transcript)
    RUNTIME_VERSION="$(plugin_version "$AGENT_COMMS_RUNTIME_ROOT")"
    IMMUTABLE_ROOT="$(claude_cache_base)/$RUNTIME_VERSION"
    if [ ! -d "$IMMUTABLE_ROOT" ] ||
       [ "$(realpath "$AGENT_COMMS_RUNTIME_ROOT")" != "$(realpath "$IMMUTABLE_ROOT")" ]; then
      echo "channel commands require an immutable cache release: $IMMUTABLE_ROOT" >&2
      exit 1
    fi
    ;;
esac

case "$cmd" in
  init)          cmd_init "$@";;
  send)          cmd_send "$@";;
  recv)          cmd_recv "$@";;
  wait-ready)    cmd_wait_ready "$@";;
  resume)        cmd_resume "$@";;
  launch)        cmd_launch "$@";;
  transcript)    cmd_transcript "$@";;
  path)          cmd_path "$@";;
  hash)          cmd_hash "$@";;
  install)       cmd_install "$@";;
  update)        cmd_update "$@";;
  doctor)        cmd_doctor "$@";;
  release)       cmd_release "$@";;
  -h|--help|help) usage; exit 0;;
  "") usage; exit 64;;
  *) echo "unknown subcommand: $cmd" >&2; usage; exit 64;;
esac
