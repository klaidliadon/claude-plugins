#!/usr/bin/env bash
echo "orca $*" >>"$STUB_LOG"
[ "${STUB_ORCA_FAIL:-}" = 1 ] && exit 1
case "$1 $2" in
  "worktree rm")
    git -C "$STUB_PRIMARY" worktree remove --force "$STUB_WT_PATH"
    echo '{"ok":true}'
    ;;
  "worktree show") printf '{"ok":true,"result":{"worktree":{"path":"%s"}}}' "${STUB_WT_SHOW_PATH:-$STUB_WT_PATH}" ;;
  "orchestration task-list")
    if [ "${STUB_ORCA_FENCE_TASKS:-}" = 1 ] && [ "$4" = "${STUB_ORCA_FENCED_RUN:-}" ]; then
      cat "$STUB_ORCA_FENCED"
      exit "${STUB_ORCA_FENCED_EXIT:-0}"
    fi
    cat "$STUB_ORCA_TASKS"
    ;;
  "orchestration check")
    if [ -n "${STUB_ORCA_FENCED_RUN:-}" ] && [ "$4" = "$STUB_ORCA_FENCED_RUN" ]; then
      cat "$STUB_ORCA_FENCED"
      exit "${STUB_ORCA_FENCED_EXIT:-0}"
    fi
    cat "$STUB_ORCA_CHECK"
    ;;
  "orchestration run-list") cat "${STUB_ORCA_RUNS:-/dev/null}" ;;
  "orchestration run-create")
    sleep "${STUB_ORCA_CREATE_SLEEP:-0}"
    cat "$STUB_ORCA_CREATE"
    ;;
  "orchestration worker-show")
    [ -n "${STUB_ORCA_WORKER_SHOW:-}" ] || exit 1
    cat "$STUB_ORCA_WORKER_SHOW"
    ;;
esac
