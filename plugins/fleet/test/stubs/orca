#!/usr/bin/env bash
echo "orca $*" >>"$STUB_LOG"
[ "${STUB_ORCA_FAIL:-}" = 1 ] && exit 1
case "$1 $2" in
  "worktree rm")
    git -C "$STUB_PRIMARY" worktree remove --force "$STUB_WT_PATH"
    echo '{"ok":true}'
    ;;
  "worktree show") printf '{"ok":true,"result":{"worktree":{"path":"%s"}}}' "${STUB_WT_SHOW_PATH:-$STUB_WT_PATH}" ;;
  "orchestration task-list")
    if [ "${STUB_ORCA_FENCE_TASKS:-}" = 1 ] && [ "$4" = "${STUB_ORCA_FENCED_RUN:-}" ]; then
      cat "$STUB_ORCA_FENCED"
      exit "${STUB_ORCA_FENCED_EXIT:-0}"
    fi
    cat "$STUB_ORCA_TASKS"
    ;;
  "orchestration check")
    if [ -n "${STUB_ORCA_FENCED_RUN:-}" ] && [ "$4" = "$STUB_ORCA_FENCED_RUN" ]; then
      cat "$STUB_ORCA_FENCED"
      exit "${STUB_ORCA_FENCED_EXIT:-0}"
    fi
    cat "$STUB_ORCA_CHECK"
    ;;
  "orchestration run-list") cat "${STUB_ORCA_RUNS:-/dev/null}" ;;
  "orchestration run-create")
    sleep "${STUB_ORCA_CREATE_SLEEP:-0}"
    cat "$STUB_ORCA_CREATE"
    ;;
  "orchestration run-use") cat "${STUB_ORCA_RUN_USE:-/dev/null}"; exit "${STUB_ORCA_RUN_USE_EXIT:-0}" ;;
  "orchestration run-current") cat "${STUB_ORCA_RUN_CURRENT:-/dev/null}"; exit "${STUB_ORCA_RUN_CURRENT_EXIT:-0}" ;;
  "terminal create")
    printf '%s\n' "$@" >"$STUB_LOG.create"
    cat "${STUB_ORCA_TERM_CREATE:-/dev/null}"
    exit "${STUB_ORCA_TERM_CREATE_EXIT:-0}"
    ;;
  "terminal wait") cat "${STUB_ORCA_TERM_WAIT:-/dev/null}"; exit "${STUB_ORCA_TERM_WAIT_EXIT:-0}" ;;
  "terminal close") cat "${STUB_ORCA_TERM_CLOSE:-/dev/null}"; exit "${STUB_ORCA_TERM_CLOSE_EXIT:-0}" ;;
  "orchestration worker-show")
    [ -n "${STUB_ORCA_WORKER_SHOW:-}" ] || exit 1
    cat "$STUB_ORCA_WORKER_SHOW"
    ;;
esac
