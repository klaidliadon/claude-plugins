{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/fleet-session-start" }] },
      { "matcher": "clear", "hooks": [{ "type": "command", "command": "${CLAUDE_PLUGIN_ROOT}/bin/fleet-session-start" }] },
